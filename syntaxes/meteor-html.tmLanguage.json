{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Meteor HTML",
  "scopeName": "text.html.meteor",
  "patterns": [
    { "include": "#tsdoc-comments" },
    { "include": "#template-blocks" },
    { "include": "text.html.handlebars" }
  ],
  "semanticTokenColors": {
    "blazeBlockName": {
      "foreground": "#f07dff",
      "fontStyle": "italic bold"
    }
  },
  "repository": {
    "template-blocks": {
      "patterns": [
        {
          "name": "meta.template.meteor",
          "begin": "(<template\\s+name=)([\\\"'])([^\\\"']+)\\2(>)",
          "end": "(</template>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "punctuation.definition.string.begin.html" },
            "3": {
              "name": "string.quoted.double.html entity.name.tag.template.meteor"
            },
            "4": { "name": "punctuation.definition.string.end.html" },
            "5": { "name": "punctuation.definition.tag.end.html" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.html" }
          },
          "patterns": [
            { "include": "#tsdoc-comments" },
            { "include": "#blaze-helpers" },
            { "include": "#meteor-events" },
            { "include": "text.html.handlebars" }
          ]
        }
      ]
    },
    "tsdoc-comments": {
      "patterns": [
        {
          "name": "comment.block.handlebars.tsdoc.meteor",
          "begin": "\\{\\{!--",
          "end": "--\\}\\}",
          "patterns": [
            {
              "name": "storage.type.class.tsdoc.meteor",
              "match": "(@)(param|template|description|returns|example|see|author|since|deprecated)\\b",
              "captures": {
                "1": { "name": "punctuation.definition.tag.tsdoc.meteor" },
                "2": { "name": "keyword.other.tsdoc.meteor" }
              }
            },
            {
              "name": "meta.type.annotation.tsdoc.meteor",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "name": "support.type.primitive.tsdoc.meteor",
                  "match": "\\b(string|number|boolean|any|void|null|undefined|never|unknown)\\b"
                },
                {
                  "name": "entity.name.type.tsdoc.meteor",
                  "match": "\\b[A-Z][a-zA-Z0-9]*\\b"
                },
                {
                  "name": "keyword.operator.type.tsdoc.meteor",
                  "match": "[|&<>\\[\\]:]"
                }
              ]
            },
            {
              "name": "variable.parameter.tsdoc.meteor",
              "match": "(?<=@param\\s+\\{[^}]+\\}\\s+)(\\[)?([a-zA-Z_$][\\w$]*)(\\]|\\?)?",
              "captures": {
                "1": { "name": "punctuation.definition.optional.tsdoc.meteor" },
                "2": { "name": "variable.parameter.name.tsdoc.meteor" },
                "3": { "name": "punctuation.definition.optional.tsdoc.meteor" }
              }
            },
            {
              "name": "meta.description.tsdoc.meteor",
              "match": "(-\\s*)(.*)$",
              "captures": {
                "1": { "name": "punctuation.separator.tsdoc.meteor" },
                "2": { "name": "comment.line.tsdoc.meteor" }
              }
            }
          ]
        },
        {
          "name": "comment.line.handlebars.meteor",
          "begin": "\\{\\{!",
          "end": "\\}\\}",
          "patterns": [
            {
              "name": "comment.line.content.handlebars.meteor",
              "match": ".*"
            }
          ]
        }
      ]
    },
    "blaze-helpers": {
      "patterns": [
        {
          "name": "meta.helper.block.meteor",
          "begin": "(\\{\\{#)(if|each|unless|with)\\b([^{}}]*)?(\\}\\})",
          "end": "(\\{\\{/)(if|each|unless|with)(\\}\\})",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.meteor" },
            "2": { "name": "entity.name.tag.meteor keyword.control.meteor" },
            "3": { "name": "variable.parameter.meteor" },
            "4": { "name": "punctuation.definition.tag.end.meteor" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.meteor" },
            "2": { "name": "entity.name.tag.meteor keyword.control.meteor" },
            "3": { "name": "punctuation.definition.tag.end.meteor" }
          },
          "patterns": [{ "include": "text.html.handlebars" }]
        },
        {
          "name": "meta.helper.expression.meteor",
          "begin": "(\\{\\{)",
          "end": "(\\}\\})",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.meteor" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.meteor" }
          },
          "patterns": [
            { "include": "#blaze-expressions" },
            { "include": "text.html.handlebars" }
          ]
        }
      ]
    },
    "blaze-expressions": {
      "patterns": [
        {
          "name": "variable.other.helper.meteor",
          "match": "\\b(this|@index|@key|@first|@last)\\b"
        },
        {
          "name": "entity.name.function.helper.meteor",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s)"
        },
        {
          "name": "variable.other.property.meteor",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "keyword.operator.meteor",
          "match": "\\."
        }
      ]
    },
    "meteor-events": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.event.meteor",
          "match": "\\b(click|submit|change|keyup|keydown|mouseenter|mouseleave|focus|blur)\\b(?=\\s*=)"
        }
      ]
    }
  }
}
