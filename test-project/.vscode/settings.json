{
  // Meteor/Blaze Language Server Configuration Examples
  // These settings override the defaults to show distinctly different styling

  // Basic language server settings
  "meteorLanguageServer.maxNumberOfProblems": 50,
  "meteorLanguageServer.trace.server": "messages",

  // Block condition decoration overrides - distinctly different from defaults
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "blazeBlockHash": { "foreground": "#808080", "fontStyle": "bold" },
      "blazeBlockName": { "foreground": "#f177ff", "fontStyle": "italic bold" },
      "blazeBlockArgs": { "foreground": "#fffec4", "fontStyle": "bold" },
      "blazeBlockFirstArg": { "foreground": "#ffd16f", "fontStyle": "bold" },
      "blazeBlockSingleArg": { "foreground": "#ffd16f", "fontStyle": "bold" },
      "blazeExpression": { "foreground": "#ffd16f" },
      "blazeBlockIn": { "foreground": "#00ffa2", "fontStyle": "italic bold" },
      "delimiter": { "foreground": "#808080", "fontStyle": "bold" }
    }
  },

  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "storage.type.class.tsdoc.meteor",
        "settings": {
          "foreground": "#9CDCFE",
          "fontStyle": ""
        }
      },
      {
        "scope": "keyword.other.tsdoc.meteor",
        "settings": {
          "foreground": "#888888",
          "fontStyle": "italic"
        }
      },
      {
        "scope": "support.type.primitive.tsdoc.meteor",
        "settings": {
          "foreground": "#8c8c8c"
        }
      },
      {
        "scope": "variable.parameter.tsdoc.meteor",
        "settings": {
          "foreground": "#ffe895"
        }
      },
      {
        "scope": "comment.block.handlebars.tsdoc.meteor",
        "settings": {
          "foreground": "#0095ff"
        }
      }
    ]
  },

  "meteorLanguageServer.templateComments": {
    // ===================================================================
    // Enable Autocomplete for TSDoc Tags
    // ===================================================================
    // When enabled, typing {{!-- @ will trigger autocomplete suggestions
    // for TSDoc tags like @param, @template, @description, etc.
    "enableAutocomplete": true,

    // ===================================================================
    // Validation Level
    // ===================================================================
    // Controls how strictly TSDoc syntax is validated in template comments.
    // Options:
    //   "off"     - No validation (comments are purely informational)
    //   "info"    - Show informational hints (default, non-intrusive)
    //   "warning" - Show warnings for incorrect syntax
    //   "error"   - Show errors for incorrect syntax
    "validationLevel": "info",

    // ===================================================================
    // Prefer TSDoc Descriptions
    // ===================================================================
    // When true, descriptions from {{!-- @template ... --}} comments
    // take precedence over JSDoc comments in .js/.ts controller files.
    // This allows you to document templates directly in the HTML.
    "preferTsDocDescriptions": true,

    // ===================================================================
    // Custom Tags
    // ===================================================================
    // Add your own custom @ tags beyond the built-in ones.
    // Built-in tags: @param, @template, @description
    //
    // Common custom tags to add:
    "customTags": [
      "author", // Document who created the template
      "since", // Document when the template was added
      "example", // Provide usage examples
      "deprecated", // Mark templates as deprecated
      "see", // Reference related templates or docs
      "todo", // Note planned improvements
      "note", // Add important notes
      "version" // Track template version
    ]
  },

  "meteorLanguageServer.blockConditions": {
    "extend": [
      {
        "type": "mrkdwn",
        "label": "Custom Markdown Block",
        "propNames": ["text", "markdown", "content"],
        "requiresEndTag": true,
        "autoInsertEndTag": true
      }
    ],
    "margin": "0 0 0 0.75em",
    "fontStyle": "italic",
    "color": "#727272"
  },

  "meteorLanguageServer.blazeHelpers": {
    "extend": [
      {
        "name": "#mrkdwn",
        "doc": "Custom markdown block"
      }
    ]
  },

  // New globalHelpers configuration with rich documentation
  "meteorLanguageServer.globalHelpers": {
    "extend": [
      {
        "name": "testHelper",
        "doc": "A test helper for demonstrating the new configuration format.",
        "params": [
          {
            "name": "value",
            "type": "string",
            "doc": "The value to process."
          }
        ],
        "return": {
          "type": "string",
          "doc": "The processed value."
        },
        "examples": [
          {
            "html": "{{ testHelper 'example' }}"
          }
        ]
      },
      {
        "name": "formatCurrency",
        "doc": "Format a number as currency.",
        "params": [
          {
            "name": "amount",
            "type": ["number", "string"],
            "doc": "The amount to format."
          },
          {
            "name": "currency",
            "type": "string",
            "optional": true,
            "default": "USD",
            "doc": "The currency code."
          }
        ],
        "return": {
          "type": "string"
        },
        "examples": [
          {
            "html": "{{ formatCurrency 99.99 }}"
          },
          {
            "html": "{{ formatCurrency total 'EUR' }}"
          }
        ]
      }
    ]
  },
  "meteorLanguageServer.formatting": {
    "enabled": true,
    "indentSize": 2,
    "baseFormatter": "vscode.html-language-features"
  },

  // Additional VS Code settings for better development experience
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "files.associations": {
    "*.html": "handlebars"
  },

  // ===================================================================
  // IMPORTANT: Enable Autocomplete in Comments
  // ===================================================================
  // VS Code disables autocomplete inside comments by default.
  // You MUST enable this for TSDoc autocomplete to work when typing @

  // Language-specific settings
  "[html]": {
    "editor.quickSuggestions": {
      "comments": true,
      "strings": true,
      "other": true
    },
    "editor.defaultFormatter": "ptbarnum4.meteor-blaze-vscode-language-server",
    "editor.suggest.insertMode": "replace",
    "editor.bracketPairColorization.enabled": false // Disable bracket pair colorization for HTML
  },
  "[handlebars]": {
    "editor.quickSuggestions": {
      "comments": true,
      "strings": true,
      "other": true
    },
    "editor.defaultFormatter": "ptbarnum4.meteor-blaze-vscode-language-server"
  },
  "[meteor-html]": {
    "editor.quickSuggestions": {
      "comments": true,
      "strings": true,
      "other": true
    }
  },
  "[meteor-handlebars]": {
    "editor.quickSuggestions": {
      "comments": true,
      "strings": true,
      "other": true
    }
  },
  "html.format.indentHandlebars": true,
  "html.format.templating": true,
  "html.format.wrapAttributesIndentSize": null,
  "html.format.wrapAttributes": "force",
  "files.insertFinalNewline": true,
  "html.format.unformattedContentDelimiter": "<!-- no-format -->",

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.editor.customLabels.patterns": {
    "**/README.md": "${dirname} (README)",
    "**/index.jsx": "${dirname} (.${extname})",
    "**/index.tsx": "${dirname} (.${extname})",
    "**/index.js": "${dirname} (.${extname})",
    "**/index.ts": "${dirname} (.${extname})",
    "**/index.html": "${dirname} (.${extname})",
    "**/template.html": "${dirname} (template.${extname})",
    "**/index.css": "${dirname} (.${extname})",
    "**/style.css": "${dirname} (.${extname})",
    "**/index.less": "${dirname} (.${extname})",
    "**/style.less": "${dirname} (.${extname})",
    "**/styles.less": "${dirname} (.${extname})"
  }
}
